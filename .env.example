SESSION_SECRET=

# Stripe Payment Link (« Soutenir le projet ») — shown in the hero + footer (except on the homepage).
# SUPPORT_URL=https://buy.stripe.com/…

# Canonical public URL (prod) — reset / invite / share links. Prevents Host-header poisoning.
# APP_ORIGIN=https://ohyoushouldnt.app

# Password reset (optional — otherwise the link goes to data/password-reset.log)
RESEND_API_KEY=
MAIL_FROM=
# Unconfirmed address tolerated: no more blocking, confirmation e-mails are still sent (temporary).
# EMAIL_VERIFICATION_OPTIONAL=1
# Show the reset link in the UI if mail fails — DEV ONLY (ignored in production).
# PASSWORD_RESET_SHOW_LINK=1
# Simulated sending: e-mails written to data/mail.log, address validation on — DEV ONLY (ignored in production).
# MAIL_DRY_RUN=1
# Sending through a local SMTP server (MailDev, e2e suite) instead of Resend — DEV ONLY (ignored in production).
# MAIL_SMTP_URL=smtp://localhost:1025

# Umami audience measurement, optional. Without both values, no script is loaded.
# UMAMI_WEBSITE_ID=
# UMAMI_URL=https://analytics.example

# Product enrichment from a URL (optional — Gemini takes priority if both are set)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini


# API for a mobile app: allowed web origins besides the site, comma-separated (optional).
# Without a value, only the site and native clients (no Origin header) call the API.
# API_ALLOWED_ORIGINS=capacitor://localhost,https://localhost

# Site links opened by the mobile app (optional). Without a value, /.well-known/… returns 404 and the links open the site.
# APPLE_TEAM_ID=ABCDE12345
# ANDROID_CERT_SHA256=AA:BB:…,CC:DD:…

# App listings on the stores (optional): the site's « l'app sur votre téléphone » icon, on a phone.
# Without both, the icon does not appear.
# APP_STORE_URL=https://apps.apple.com/app/id…
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.ohyoushouldnt.mobile
