{
  "name": "whishlist",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "demo:data": "node --conditions=react-server --import tsx scripts/create-demo-data.mjs",
    "demo:capture": "node scripts/capture-demo.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "node --conditions=react-server --import tsx scripts/db-check.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test --test-concurrency=1 'tests/domain/*.test.ts'"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "i18next": "^26.5.3",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "postcss": "^8.5.30",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.1.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "shadcn": "^4.22.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
